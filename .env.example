NODE_ENV=development
PORT=3001
DATABASE_URL=./data/tech-library.db
# Docker Compose host binding. Change both values when using another port.
HOST_PORT=8144
WEB_ORIGIN=http://localhost:8144
ADMIN_USERNAME=admin
# Generate with: npm run password:hash -w @tech-library/api -- "your password"
ADMIN_PASSWORD_HASH=
SESSION_SECRET=replace-with-at-least-32-random-characters
SOURCE_POLL_INTERVAL_HOURS=24
